FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# ---------------------------------------------------------------------------
# System dependencies — single layer to minimise image size
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake \
    ninja-build \
    g++ \
    git \
    ca-certificates \
    libcap-dev \
    libpcap-dev \
    libcap2-bin \
    librabbitmq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY . .

RUN cmake --preset docker && \
    cmake --build --preset docker

# ---------------------------------------------------------------------------
# Entrypoint — binary is absolute path; CMD is empty so docker-compose
# can pass env vars via 'environment:' without overriding the binary.
# ---------------------------------------------------------------------------
ENTRYPOINT ["/app/build/docker/packet-engine"]
CMD []